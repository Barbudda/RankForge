{
  "name": "septune",
  "version": "0.1.0",
  "private": true,
  "description": "Septune — a technical-SEO agent for GitHub repos that audits your modern site and opens ready-to-merge pull requests.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cli:build": "tsup --config cli/tsup.config.ts",
    "cli:test": "npm run cli:build && node --test cli/test/cli.test.mjs cli/test/v3.test.mjs",
    "test:monitor": "node --test tests/monitor.test.mjs",
    "test": "npm run cli:test && npm run test:monitor && npm run test:billing && npm run test:tools && npm run test:preorder",
    "stripe:setup": "node --env-file-if-exists=.env.local scripts/stripe-setup.ts",
    "test:billing": "node --test tests/billing.test.mjs",
    "test:tools": "node --test tests/tools.test.mjs",
    "preorders:notify": "node --env-file-if-exists=.env.local scripts/notify-preorders.ts",
    "test:preorder": "node --test tests/preorder.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "^23.0.1",
    "tailwind-merge": "latest",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.184.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsup": "^8.5.1",
    "typescript": "latest"
  }
}
