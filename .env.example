# ─────────────────────────────────────────────────────────────
# Septune — environment variables
# Copy to `.env.local` and fill in. The app ships production-ready
# with NONE of these set: it starts empty (real empty states), and
# the support chatbot falls back to an offline knowledge base.
# Load the labelled sample dataset anytime via the in-app Dev button.
# ─────────────────────────────────────────────────────────────

# Toggle the data/runtime layer. "mock" (default) ships realistic
# fixtures with zero external dependencies. "live" wires the real
# GitHub / crawler / LLM adapters (not all implemented in the MVP).
RANKFORGE_MODE=mock

# Public app URL (canonical links, OG tags, emails, Stripe redirects).
# Production: https://www.rank-forge.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operators: comma-separated emails that see the go-live checklist in
# Settings (which integrations are set; values are never shown).
RANKFORGE_ADMIN_EMAILS=

# ── Account owner (solo product — one real user/workspace) ───
# These set the identity shown in the app. All optional; sensible
# defaults are used if unset. NEXT_PUBLIC_* are exposed to the browser.
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_OWNER_EMAIL=
NEXT_PUBLIC_OWNER_GITHUB=
NEXT_PUBLIC_OWNER_AVATAR=
NEXT_PUBLIC_WORKSPACE_NAME=

# ── Supabase (database + auth + storage) ────────────────────
# Find these in your Supabase project → Project Settings → API keys.
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (client-safe) key — starts with "sb_publishable_".
# Older projects call this the "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (server-only) key — starts with "sb_secret_". NEVER expose to the
# browser / never prefix with NEXT_PUBLIC_. Required in production: the
# monitoring cron, "Check now" and the Stripe webhook write with it (plan,
# billing and check-result columns are locked against users, migration 0005).
SUPABASE_SECRET_KEY=

# ── Billing (Stripe) ─────────────────────────────────────────
# 1. Secret key: Stripe Dashboard → Developers → API keys. sk_test_… while
#    testing, sk_live_… in production. Server-only.
STRIPE_SECRET_KEY=
# 2. Run `npm run stripe:setup`: it creates the Pro and Studio prices, the
#    customer portal and the webhook (https://www.rank-forge.dev/api/stripe/webhook)
#    and prints the two values below. Run it once in test mode, once in live.
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
# Optional: explicit price ids instead of the lookup keys the setup creates.
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Optional: "1" to have Stripe Tax compute VAT at checkout (needs Stripe Tax
# set up and your registrations entered in the Stripe dashboard).
STRIPE_AUTOMATIC_TAX=
# 3. Open payments (see the bottom of this file).

# ── GitHub App (roadmap: not used yet) ───────────────────────
# Read by src/lib/config.ts for the future GitHub App that opens pull
# requests. Nothing calls GitHub today; leave empty.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── LLM (optional — Septune works WITHOUT any of this) ─────
# What runs with ZERO config / zero key:
#   • Audits        — 100% deterministic engine (crawl + rules + link graph
#                     + semantic internal-link suggestions). No LLM.
#   • Fixes         — mechanical issues (viewport, lang, canonical, robots,
#                     sitemap, JSON-LD, social) get a deterministic patch.
#   • Support chat  — extractive answers from the local RAG corpus.
# A generative LLM only ADDS: audit content-quality enrichment, fixes for
# judgment-heavy issues, and a generative (vs extractive) chatbot.
#
# Pick ONE generative backend (or none):

# (a) Anthropic API key — production path. Paid per token.
ANTHROPIC_API_KEY=
# Optional model overrides (both default to claude-opus-4-8).
RANKFORGE_CHAT_MODEL=
RANKFORGE_AGENT_MODEL=

# (b) FREE / LOCAL model — Ollama or any OpenAI-compatible endpoint. No key,
#     no billing, runs offline. Install Ollama, `ollama pull llama3.1`, then:
#       RANKFORGE_LLM=ollama
#     Also works with LM Studio / llama.cpp, or a hosted free tier (Groq,
#     Gemini OpenAI-compat) by setting the base URL + a free key below.
# (c) Claude CLI on your Claude Code SUBSCRIPTION (dev only, no API billing):
#       RANKFORGE_LLM=claude-cli
RANKFORGE_LLM=
# Local/OpenAI-compatible model config (only used when RANKFORGE_LLM=ollama|openai-compat):
RANKFORGE_LLM_BASE_URL=http://localhost:11434/v1
RANKFORGE_LLM_MODEL=llama3.1
RANKFORGE_LLM_API_KEY=
# Optional CLI model override when RANKFORGE_LLM=claude-cli (opus/sonnet/haiku).
RANKFORGE_CLI_MODEL=

# ── MCP endpoint (/api/mcp — the Septune agent in your editor) ──
# Open on localhost in development. A DEPLOYED instance audits PUBLIC URLs
# (it can't reach a user's localhost) and is locked by default. To let others
# connect, pick ONE:
#   • RANKFORGE_MCP_PUBLIC=1     → open the endpoint (SSRF still blocks
#                                  private/internal hosts). Easiest for a demo.
#   • RANKFORGE_MCP_KEY=<secret> → require this as a Bearer token instead.
RANKFORGE_MCP_PUBLIC=
RANKFORGE_MCP_KEY=

# ── Monitoring (scheduled checks + alerts) ───────────────────────────
# Septune checks monitored sites on a schedule (vercel.json cron, daily)
# and alerts when a deploy breaks SEO. All optional: without them the
# Monitoring page still works with "Check now".
# Secret Vercel sends to the cron route (Authorization: Bearer …). Any long
# random string; set it in Vercel → Settings → Environment Variables.
CRON_SECRET=
# Scheduled checks also need SUPABASE_SECRET_KEY (above): the cron has no
# signed-in user, so it writes with the service-role key.
# Email alerts via Resend (free tier: 3,000 emails/month). Without a verified
# domain, Resend only delivers to your own account address.
RESEND_API_KEY=
# Verified sender, e.g. "Septune <alerts@yourdomain.com>".
RANKFORGE_ALERT_FROM=
# Core Web Vitals (real Chrome users) in checks and `septune vitals`:
# free Google Cloud API key with the "Chrome UX Report API" enabled.
CRUX_API_KEY=

# ── Billing switch ────────────────────────────────────────────────────
# Leave unset during the beta (everyone gets Pro limits for free; the
# pricing page says so). Set to "open" once the Stripe values above are set
# and the go-live checklist in Settings is green: checkout then appears on
# /billing and the pricing page. Public on purpose (server and browser
# render the same buttons); redeploy after changing it.
NEXT_PUBLIC_RANKFORGE_BILLING=

# ── Legal notice (/legal, mentions légales) ──────────────────────────
# Required in France for a site that sells. /legal stays hidden (404, no
# footer link, not in the sitemap) until NAME, ADDRESS, SIRET and EMAIL are
# set. Server-only values, shown publicly on that page.
LEGAL_NAME=
# e.g. "Entrepreneur individuel (micro-entreprise)"
LEGAL_STATUS=
LEGAL_ADDRESS=
LEGAL_SIRET=
# VAT number, or "TVA non applicable, art. 293 B du CGI"
LEGAL_VAT=
LEGAL_EMAIL=
LEGAL_PHONE=
# Publication director (defaults to LEGAL_NAME)
LEGAL_DIRECTOR=
